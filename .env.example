# Server-only admin credentials. Use a strong unique password.
ADMIN_USERNAME=your-admin-username
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Supabase project URL and public browser key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server-only key. Never expose this in public/ or browser JavaScript.
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-or-secret-key

PORT=3000
